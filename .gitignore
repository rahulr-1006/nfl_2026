# Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.DS_Store

# Secrets. Any .env variant (e.g. .env.bak-20260908) holds both Odds API keys and
# the alert phone number; `.env` alone did not match the dated backups.
.env*

# Data. Odds snapshots are collected locally; nflverse data is rebuilt by `make data`.
data/snapshots/**/*.parquet
!data/snapshots/.gitkeep
data/snapshots_preseason/**/*.parquet
!data/snapshots_preseason/.gitkeep
data/demo_snapshots/
data/static/*.parquet

# Runtime state written by the live services. Not source, and committing it would
# make the working tree fight the running services on every pull.
data/collect_state.json
data/props_collect_state.json
data/alert_state.json
data/shadow_log.jsonl
data/residual_sigma_cache.json
# Also the blinded H1/H1b holdout record (docs/preregistration_wk5-9.md).
data/shadow_log_prereg.jsonl
logs/

# Dated backups of runtime/static state taken before risky operations.
data/*.bak-*
data/static/*.bak-*

# Personal working notes, AI-tooling config and the local code-graph index.
notes/
CLAUDE.md
.claude/
graphify-out/

# Per-day cache of priced alert bets written by notebooks/alert_clv_analysis.ipynb.
data/cache/
